# --- Base de datos ---
# Producción (Postgres):  postgresql+psycopg2://user:pass@host:5432/whatsapp_agent
# Desarrollo (rápido):    sqlite:///./dev.db
DATABASE_URL=sqlite:///./dev.db

# --- Motor de IA (Claude) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
AGENT_MODEL=claude-sonnet-4-6

# --- WhatsApp Cloud API (Meta) ---
# Token de System User / App (Bearer). Por simplicidad es a nivel de app;
# en producción multi-tenant real cada negocio tiene su propio token (Embedded Signup).
WHATSAPP_TOKEN=EAAxxxxxxxxxxxx
WHATSAPP_API_VERSION=v21.0
# Token que TÚ inventas y registras en Meta para verificar el webhook (GET).
WHATSAPP_VERIFY_TOKEN=mi-token-secreto

# URL pública del backend (para los links de pago / retorno). Usa ngrok en dev.
PUBLIC_BASE_URL=https://tu-dominio.com

# --- Pasarela de pago (Wompi - Colombia) ---
# Sandbox: https://sandbox.wompi.co/v1   |   Producción: https://production.wompi.co/v1
WOMPI_BASE_URL=https://sandbox.wompi.co/v1
WOMPI_PRIVATE_KEY=prv_test_xxxxxxxx
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxx
